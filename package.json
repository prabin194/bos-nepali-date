{
  "name": "bos-nepali-date",
  "version": "0.3.0",
  "type": "module",
  "description": "Reusable React Bikram Sambat (Nepali) date picker with pluggable conversion engine.",
  "license": "MIT",
  "author": "Prabin Paudel",
  "repository": {
    "type": "git",
    "url": "https://github.com/prabin194/bos-nepali-date.git"
  },
  "homepage": "https://prabin194.github.io/bos-nepali-date/",
  "bugs": {
    "url": "https://github.com/prabin194/bos-nepali-date/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "style": "./dist/index.css",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style": "./dist/index.css",
    "./index.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "docs:build-index": "node scripts/build-search-index.js",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test -- --run && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "nepali",
    "bikram-sambat",
    "date-picker",
    "react",
    "calendar",
    "nepali-calendar",
    "datepicker",
    "component",
    "ui",
    "nepal",
    "bs-date"
  ],
  "sideEffects": [
    "./dist/index.css",
    "./src/styles/base.css"
  ],
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^20.11.20",
    "@types/react": "^18.2.62",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "esbuild": "0.27.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^10.4.5",
    "jsdom": "^24.0.0",
    "playwright": "^1.60.0",
    "storybook": "^10.4.4",
    "tsup": "^8.0.1",
    "typescript": "5.3.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "esbuild": "0.27.3"
  }
}
